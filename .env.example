# Copy to .env and fill in. .env is git-ignored and never baked into the Docker image.
# Optional: enables paid logo generation via OpenAI. Without it, logos come from Pollinations (free).
OPENAI_API_KEY=
# Optional for docker compose behind an HTTPS reverse proxy:
# BOTC_WEB_PUBLIC_URL=https://botc.example.com
# BOTC_WEB_TRUSTED_PROXIES=192.0.2.10
# BOTC_WEB_SECURE_COOKIES=1
# BOTC_WEB_TRUST_PROXY=1
